.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.step-indicator {
  background: #fff;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 60%;
  width: 80%;
  height: 2rpx;
  background: #e0e0e0;
}

.step-item.completed:not(:last-child)::after {
  background: #52c41a;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  z-index: 1;
}

.step-item.active .step-circle {
  background: #1890ff;
  color: #fff;
}

.step-item.completed .step-circle {
  background: #52c41a;
}

.step-circle image {
  width: 28rpx;
  height: 28rpx;
}

.step-circle text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.step-label {
  font-size: 22rpx;
  color: #999;
}

.step-item.active .step-label {
  color: #1890ff;
  font-weight: 600;
}

.step-item.completed .step-label {
  color: #52c41a;
}

.step-content {
  padding: 32rpx;
}

.step-header {
  margin-bottom: 32rpx;
}

.step-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #999;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.required {
  color: #f5222d;
  margin-right: 8rpx;
}

.form-label text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.form-input {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
}

.form-input.error {
  border-color: #f5222d;
}

.form-input input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.date-input {
  justify-content: space-between;
}

.date-text {
  font-size: 32rpx;
  color: #333;
}

.placeholder {
  font-size: 32rpx;
  color: #999;
}

.picker-btn {
  padding: 12rpx 24rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.error-tip {
  font-size: 24rpx;
  color: #f5222d;
  margin-top: 8rpx;
}

.form-tip {
  display: flex;
  align-items: flex-start;
  background: rgba(24, 144, 255, 0.08);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.form-tip.warning {
  background: rgba(250, 173, 20, 0.1);
}

.form-tip image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.form-tip text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.upload-area {
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.upload-area.error {
  border-color: #f5222d;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

.upload-preview {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
}

.upload-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 16rpx;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon image {
  width: 32rpx;
  height: 32rpx;
}

.action-icon.delete {
  background: rgba(245, 34, 45, 0.8);
}

.cert-sample {
  margin-top: 32rpx;
  text-align: center;
}

.sample-title {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
}

.sample-img {
  width: 300rpx;
  height: 200rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.sample-desc {
  font-size: 24rpx;
  color: #999;
}

.face-area {
  padding: 40rpx;
}

.face-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.face-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.face-hint {
  font-size: 28rpx;
  color: #666;
}

.face-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background: rgba(82, 196, 26, 0.1);
  border-radius: 16rpx;
}

.face-success image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.success-text {
  font-size: 32rpx;
  color: #52c41a;
  font-weight: 600;
}

.success-content {
  padding: 80rpx 32rpx;
  text-align: center;
}

.success-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 40rpx;
}

.success-icon image {
  width: 100%;
  height: 100%;
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.success-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 60rpx;
}

.success-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  padding: 28rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
}

.action-btn.secondary {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.prev-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.next-btn {
  flex: 2;
  padding: 28rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
  border: none;
}

.next-btn.submit {
  flex: 1;
  background: linear-gradient(135deg, #52c41a, #95de64);
}
