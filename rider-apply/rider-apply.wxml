<view class="container">
  <!-- 步骤指示器 -->
  <view class="step-indicator">
    <view 
      class="step-item {{currentStep >= 1 ? 'active' : ''}} {{currentStep > 1 ? 'completed' : ''}}" 
      wx:for="{{totalSteps}}" 
      wx:key="index"
    >
      <view class="step-circle">
        <image wx:if="{{currentStep > index + 1}}" src="/assets/icons/completed.png" mode="aspectFit"></image>
        <text wx:else>{{index + 1}}</text>
      </view>
      <text class="step-label">
        {{index === 0 ? '实名认证' : index === 1 ? '健康证' : index === 2 ? '有效期' : '人脸核身'}}
      </text>
    </view>
  </view>

  <!-- Step 1: 实名认证 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="step-header">
      <text class="step-title">实名认证</text>
      <text class="step-desc">请填写真实的身份信息，用于骑手身份验证</text>
    </view>

    <view class="form-card">
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>真实姓名</text>
        </view>
        <view class="form-input {{errors.realName ? 'error' : ''}}">
          <input 
            type="text" 
            placeholder="请输入真实姓名" 
            value="{{realName}}"
            bindinput="onRealNameInput"
            maxlength="20"
          />
        </view>
        <text class="error-tip" wx:if="{{errors.realName}}">{{errors.realName}}</text>
      </view>

      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>身份证号</text>
        </view>
        <view class="form-input {{errors.idCard ? 'error' : ''}}">
          <input 
            type="idcard" 
            placeholder="请输入18位身份证号" 
            value="{{idCard}}"
            bindinput="onIdCardInput"
            maxlength="18"
          />
        </view>
        <text class="error-tip" wx:if="{{errors.idCard}}">{{errors.idCard}}</text>
      </view>

      <view class="form-tip">
        <image src="/assets/icons/info.png" mode="aspectFit"></image>
        <text>您的身份信息将用于骑手身份验证，不会泄露给第三方</text>
      </view>
    </view>
  </view>

  <!-- Step 2: 健康证上传 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="step-header">
      <text class="step-title">上传健康证</text>
      <text class="step-desc">请上传有效期内的健康证照片</text>
    </view>

    <view class="form-card">
      <view class="upload-area {{errors.healthCert ? 'error' : ''}}" bindtap="chooseHealthCert">
        <block wx:if="{{healthCertPreview}}">
          <image class="upload-preview" src="{{healthCertPreview}}" mode="aspectFit"></image>
          <view class="upload-actions">
            <view class="action-icon" bindtap="previewHealthCert" catchtap="previewHealthCert">
              <image src="/assets/icons/search.png" mode="aspectFit"></image>
            </view>
            <view class="action-icon delete" bindtap="removeHealthCert" catchtap="removeHealthCert">
              <image src="/assets/icons/close.png" mode="aspectFit"></image>
            </view>
          </view>
        </block>
        <block wx:else>
          <image class="upload-icon" src="/assets/icons/add.png" mode="aspectFit"></image>
          <text class="upload-text">点击上传健康证照片</text>
          <text class="upload-hint">支持 JPG/PNG 格式，大小不超过 5MB</text>
        </block>
      </view>
      <text class="error-tip" wx:if="{{errors.healthCert}}">{{errors.healthCert}}</text>

      <view class="cert-sample">
        <text class="sample-title">示例：</text>
        <image class="sample-img" src="/assets/icons/health-cert-sample.png" mode="aspectFit"></image>
        <text class="sample-desc">请确保照片清晰可见，信息完整</text>
      </view>
    </view>
  </view>

  <!-- Step 3: 有效期 -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="step-header">
      <text class="step-title">健康证有效期</text>
      <text class="step-desc">请选择健康证到期日期</text>
    </view>

    <view class="form-card">
      <view class="form-item">
        <view class="form-label">
          <text class="required">*</text>
          <text>到期日期</text>
        </view>
        <view class="form-input date-input {{errors.expireDate ? 'error' : ''}}">
          <text wx:if="{{healthCertExpireText}}" class="date-text">{{healthCertExpireText}}</text>
          <text wx:else class="placeholder">请选择健康证到期日期</text>
          <picker 
            mode="date" 
            value="{{healthCertExpireDate}}" 
            start="{{minDate}}"
            bindchange="onDateChange"
          >
            <view class="picker-btn">选择日期</view>
          </picker>
        </view>
        <text class="error-tip" wx:if="{{errors.expireDate}}">{{errors.expireDate}}</text>
      </view>

      <view class="form-tip warning">
        <image src="/assets/icons/warning.png" mode="aspectFit"></image>
        <text>健康证到期前请及时更新，否则骑手资格将被暂停</text>
      </view>
    </view>
  </view>

  <!-- Step 4: 人脸核身 -->
  <view class="step-content" wx:if="{{currentStep === 4}}">
    <view class="step-header">
      <text class="step-title">人脸核身</text>
      <text class="step-desc">为防止冒用证件，请进行人脸验证</text>
    </view>

    <view class="form-card">
      <view class="face-area">
        <block wx:if="{{faceVerified}}">
          <view class="face-success">
            <image src="/assets/icons/completed.png" mode="aspectFit"></image>
            <text class="success-text">人脸核身已通过</text>
          </view>
        </block>
        <block wx:else>
          <view class="face-placeholder" bindtap="startFaceVerify">
            <image class="face-icon" src="/assets/icons/avatar.png" mode="aspectFit"></image>
            <text class="face-hint">点击进行人脸核身</text>
          </view>
        </block>
      </view>

      <view class="form-tip">
        <image src="/assets/icons/info.png" mode="aspectFit"></image>
        <text>人脸核身将对比身份证照片，确保是本人操作</text>
      </view>
    </view>
  </view>

  <!-- 申请成功 -->
  <view class="step-content success-content" wx:if="{{applyResult && applyResult.success}}">
    <view class="success-icon">
      <image src="/assets/icons/completed.png" mode="aspectFit"></image>
    </view>
    <text class="success-title">{{applyResult.message}}</text>
    <text class="success-subtitle">骑手编号：{{applyResult.riderId}}</text>
    
    <view class="success-actions">
      <button class="action-btn primary" bindtap="goDelivery">开始接单</button>
      <button class="action-btn secondary" bindtap="goHome">返回首页</button>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions" wx:if="{{!applyResult}}">
    <button class="prev-btn" bindtap="prevStep" wx:if="{{currentStep > 1}}">上一步</button>
    <button 
      class="next-btn {{currentStep === totalSteps ? 'submit' : ''}}" 
      bindtap="{{currentStep === totalSteps ? 'submitApplication' : 'nextStep'}}"
      loading="{{loading}}"
    >
      {{currentStep === totalSteps ? '提交申请' : '下一步'}}
    </button>
  </view>
</view>
