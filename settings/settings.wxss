.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

/* 设置区块 */
.setting-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 24rpx;
  background: #fafafa;
}

.setting-list {
  padding: 0 24rpx;
}

.api-setting-list {
  padding: 24rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-left {
  display: flex;
  flex-direction: column;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.setting-right {
  display: flex;
  align-items: center;
}

.cache-size {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.version {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.setting-arrow image,
.setting-right image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.3;
}

.api-config {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.api-input {
  width: 100%;
  min-height: 80rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #333;
}

.api-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.api-btn {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #1890ff;
  font-size: 26rpx;
  line-height: 1;
}

.api-btn-primary {
  background: #1890ff;
  color: #fff;
}

.api-btn-ghost {
  background: #fff7e6;
  color: #d48806;
}

.api-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 退出按钮 */
.logout-btn {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  margin-top: 32rpx;
}

.logout-btn text {
  font-size: 32rpx;
  color: #ff4d4f;
}
