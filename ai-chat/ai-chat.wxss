/* ============================================
   AI 聊天页面 - 现代简洁设计
   ============================================ */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f2f5;
}

/* ── 顶部控制条 ───────────────────────────── */
.chat-controls {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.ctrl-btn {
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.ctrl-btn.ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #334155;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
}

.ctrl-btn.danger {
  background: rgba(255, 242, 240, 0.95);
  color: #cf1322;
  border: 1rpx solid rgba(255, 204, 199, 0.9);
}

/* ── 消息列表 ─────────────────────────────── */
.msg-list {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 320rpx;
}

/* ── 欢迎页 ─────────────────────────────── */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
}

.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1890ff 0%, #722ed1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(24, 144, 255, 0.3);
  overflow: hidden;
}

.welcome-avatar-img {
  width: 80rpx;
  height: 80rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.welcome-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.welcome-hint {
  font-size: 26rpx;
  color: #bbb;
  margin-bottom: 20rpx;
  align-self: flex-start;
}

/* 快捷话题网格 */
.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 40rpx;
}

.topic-chip {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  font-size: 27rpx;
  color: #444;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* ── 消息行 ─────────────────────────────── */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 32rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f0f0f0;
}

.avatar-spacer {
  width: 68rpx;
  flex-shrink: 0;
}

/* ── 气泡 ─────────────────────────────── */
.bubble-wrap {
  max-width: 75%;
  display: flex;
  flex-direction: column;
  margin: 0 16rpx;
}

.bubble {
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.65;
  word-break: break-all;
}

.bubble.user {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.bubble.assistant {
  background: #ffffff;
  color: #1a1a1a;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.bubble.error {
  background: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.msg-text {
  font-size: 30rpx;
  line-height: 1.65;
}

/* ── 加载动画 ─────────────────────────── */
.loading-dots {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 36rpx;
}

.dot {
  font-size: 36rpx;
  color: #1890ff;
  line-height: 1;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.9); }
  40% { opacity: 1; transform: scale(1.1); }
}

/* ── 操作栏 ─────────────────────────────── */
.msg-bar {
  display: flex;
  gap: 24rpx;
  margin-top: 10rpx;
  padding-top: 8rpx;
}

.bar-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: #aaa;
  padding: 4rpx 0;
}

.bar-icon {
  width: 30rpx;
  height: 30rpx;
}

/* ── 快捷操作 ─────────────────────────── */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.quick-chip {
  background: linear-gradient(135deg, rgba(24,144,255,0.08), rgba(114,46,209,0.08));
  color: #1890ff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
}

/* ── 底部输入栏 ─────────────────────────── */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 14rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.input-spacer {
  height: calc(260rpx + env(safe-area-inset-bottom));
}

.input-inner {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.input-field {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.chat-ta {
  width: 100%;
  min-height: 48rpx;
  max-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1a1a1a;
  background: transparent;
  border: none;
  outline: none;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-btn.active {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  box-shadow: 0 4rpx 16rpx rgba(24,144,255,0.35);
}

.send-icon {
  width: 38rpx;
  height: 38rpx;
}
