.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  flex-wrap: wrap;
}

.building-focus {
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.building-focus-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.building-focus-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon .icon-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-card.total .stat-icon .icon-text {
  font-size: 24rpx;
}

/* 教学楼筛选 */
.filter-bar {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-extra {
  padding: 12rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.update-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.filter-extra-right {
  display: flex;
  gap: 12rpx;
}

.sort-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #111111;
  font-size: 22rpx;
}

.sort-chip.active {
  background: rgba(24, 144, 255, 0.12);
  color: #111111;
}

.filter-scroll {
  display: flex;
  padding: 0 24rpx;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.filter-item.active {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
}

/* 教室列表 */
.classroom-list {
  padding: 24rpx 32rpx;
}

/* 分组标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  margin-top: 24rpx;
}

.section-header:first-child {
  margin-top: 0;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.available-header .section-dot {
  background: #52c41a;
}

.limited-header .section-dot {
  background: #faad14;
}

.busy-header .section-dot {
  background: #f5222d;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
}

/* 教室卡片 */
.classroom-item {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.available-card {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.08), rgba(82, 196, 26, 0.02));
  border-left: 6rpx solid #52c41a;
}

.limited-card {
  background: linear-gradient(135deg, rgba(250, 173, 20, 0.08), rgba(250, 173, 20, 0.02));
  border-left: 6rpx solid #faad14;
}

.busy-card {
  background: linear-gradient(135deg, rgba(245, 34, 45, 0.05), rgba(245, 34, 45, 0.02));
  border-left: 6rpx solid #f5222d;
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.room-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.room-icon.available {
  background: #52c41a;
}

.room-icon.limited {
  background: #faad14;
}

.room-icon.busy {
  background: #f5222d;
}

.room-info {
  display: flex;
  flex-direction: column;
}

.room-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.room-detail {
  font-size: 24rpx;
  color: #999;
}

.busy-card .room-detail {
  color: #f5222d;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rate-circle {
  min-width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.rate-circle.available {
  background: rgba(82, 196, 26, 0.15);
}

.rate-circle.limited {
  background: rgba(250, 173, 20, 0.15);
}

.rate-circle.busy {
  background: rgba(245, 34, 45, 0.1);
}

.rate-value {
  font-size: 24rpx;
  font-weight: 600;
}

.rate-circle.available .rate-value {
  color: #52c41a;
}

.rate-circle.limited .rate-value {
  color: #faad14;
}

.rate-circle.busy .rate-value {
  color: #f5222d;
}

.nav-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999;
}

.nav-arrow.disabled {
  opacity: 0.3;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-mask {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
