.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.type-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 16rpx;
}

.type-badge.lost {
  background: #f5222d;
}

.type-badge.found {
  background: #52c41a;
}

.title-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.user-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.nickname {
  font-size: 28rpx;
  color: #333;
}

.detail-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.detail-item {
  display: flex;
  margin-bottom: 16rpx;
}

.detail-item .label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
}

.detail-item .value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.description .label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.image-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-list image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.action-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.contact-btn {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
  border-radius: 48rpx;
  height: 88rpx;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.stats text {
  font-size: 26rpx;
  color: #999;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-state text {
  font-size: 28rpx;
  color: #999;
}
