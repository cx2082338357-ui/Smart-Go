<view class="container">
  <!-- 顶部图标 -->
  <view class="logo-section">
    <view class="logo-icon">
      <image src="/assets/icons/school.png" mode="aspectFit"></image>
    </view>
    <text class="logo-title">智慧校园</text>
    <text class="logo-subtitle">Smart Campus</text>
  </view>

  <!-- 登录方式切换 -->
  <view class="login-tabs">
    <view 
      class="tab-item {{loginType === 'wechat' ? 'active' : ''}}" 
      data-type="wechat"
      bindtap="switchLoginType"
    >
      <image src="/assets/icons/wechat.png" mode="aspectFit"></image>
      <text>微信登录</text>
    </view>
    <view 
      class="tab-item {{loginType === 'phone' ? 'active' : ''}}" 
      data-type="phone"
      bindtap="switchLoginType"
    >
      <image src="/assets/icons/phone.png" mode="aspectFit"></image>
      <text>手机登录</text>
    </view>
    <view 
      class="tab-item {{loginType === 'account' ? 'active' : ''}}" 
      data-type="account"
      bindtap="switchLoginType"
    >
      <image src="/assets/icons/account.png" mode="aspectFit"></image>
      <text>账号登录</text>
    </view>
  </view>

  <!-- ========== 微信登录 ========== -->
  <view class="login-form" wx:if="{{loginType === 'wechat'}}">
    <view class="form-intro">
      <text class="intro-title">微信授权登录</text>
      <text class="intro-desc">授权获取微信信息快速登录，无需账号密码</text>
    </view>
    
    <view class="service-list">
      <view class="service-item" wx:for="{{services}}" wx:key="icon">
        <view class="service-icon">
          <image src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <view class="service-content">
          <text class="service-title">{{item.title}}</text>
          <text class="service-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <button class="login-btn wechat" bindtap="onWechatLogin">
      <image src="/assets/icons/wechat.png" mode="aspectFit"></image>
      <text>微信一键登录</text>
    </button>

    <view class="form-tip">
      <image src="/assets/icons/info.png" mode="aspectFit"></image>
      <text>登录即表示同意《隐私政策》</text>
    </view>
  </view>

  <!-- ========== 手机号登录 ========== -->
  <view class="login-form" wx:if="{{loginType === 'phone'}}">
    <view class="form-intro">
      <text class="intro-title">手机号登录</text>
      <text class="intro-desc">输入手机号和验证码快速登录</text>
    </view>
    
    <view class="form-item">
      <view class="form-label">手机号</view>
      <view class="form-input">
        <input 
          type="number"
          placeholder="请输入手机号"
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">验证码</view>
      <view class="form-input verify-code-input">
        <input 
          type="number"
          placeholder="请输入验证码"
          maxlength="4"
          value="{{verifyCode}}"
          bindinput="onVerifyCodeInput"
        />
        <button 
          class="verify-code-btn {{verifyCodeDisabled ? 'disabled' : ''}}"
          bindtap="sendVerifyCode"
          disabled="{{verifyCodeDisabled}}"
        >
          {{verifyCodeBtnText}}
        </button>
      </view>
    </view>

    <button class="login-btn phone" bindtap="handlePhoneLogin" loading="{{loading}}">
      <text>立即登录</text>
    </button>
  </view>

  <!-- ========== 账号登录 ========== -->
  <view class="login-form" wx:if="{{loginType === 'account'}}">
    <view class="form-intro">
      <text class="intro-title">账号登录</text>
      <text class="intro-desc">使用学号和密码登录教务系统</text>
    </view>
    
    <view class="form-item">
      <view class="form-label">学号</view>
      <view class="form-input">
        <input 
          type="number"
          placeholder="请输入学号"
          maxlength="20"
          value="{{studentId}}"
          bindinput="onStudentIdInput"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">密码</view>
      <view class="form-input">
        <input 
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="请输入教务系统密码"
          maxlength="50"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view class="toggle-password" bindtap="togglePassword">
          <image src="/assets/icons/eye.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <button class="login-btn account" bindtap="handleBind" loading="{{loading}}">
      <text>立即绑定</text>
    </button>
  </view>

  <!-- 帮助链接 -->
  <view class="help-links">
    <text bindtap="goHelp">无法登录？查看帮助</text>
    <text class="separator">|</text>
    <text bindtap="goPrivacy">隐私政策</text>
  </view>
</view>
