.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1890ff 0%, #f5f5f5 40%);
  padding: 0 32rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-icon image {
  width: 80rpx;
  height: 80rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

/* 登录方式切换 */
.login-tabs {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.tab-item text {
  font-size: 26rpx;
  color: #999;
}

.tab-item.active {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
}

.tab-item.active text {
  color: #fff;
  font-weight: 600;
}

/* 服务列表 */
.service-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.service-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.service-item:last-child {
  border-bottom: none;
}

.service-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(114, 46, 209, 0.1));
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.service-icon image {
  width: 36rpx;
  height: 36rpx;
}

.service-content {
  flex: 1;
}

.service-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.service-desc {
  font-size: 22rpx;
  color: #999;
}

/* 登录表单 */
.login-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-intro {
  text-align: center;
  margin-bottom: 32rpx;
}

.intro-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: #999;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.form-input input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 48rpx;
}

/* 验证码按钮 */
.verify-code-input {
  justify-content: space-between;
}

.verify-code-input input {
  flex: 1;
  margin-right: 16rpx;
}

.verify-code-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
  white-space: nowrap;
}

.verify-code-btn::after {
  border: none;
}

.verify-code-btn.disabled {
  background: #ccc;
  pointer-events: none;
}

/* 密码显示切换 */
.toggle-password {
  width: 48rpx;
  height: 48rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

.toggle-password image {
  width: 100%;
  height: 100%;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 16rpx;
}

.login-btn::after {
  border: none;
}

.login-btn.wechat {
  background: linear-gradient(135deg, #07c160, #10b981);
}

.login-btn.phone {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
}

.login-btn.account {
  background: linear-gradient(135deg, #722ed1, #9254de);
}

.login-btn image {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}

.login-btn text {
  font-size: 32rpx;
}

/* 提示信息 */
.form-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.form-tip image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.form-tip text {
  font-size: 24rpx;
  color: #999;
}

/* 帮助链接 */
.help-links {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0 48rpx;
}

.help-links text {
  font-size: 26rpx;
  color: #fff;
  opacity: 0.9;
}

.separator {
  opacity: 0.5 !important;
}
