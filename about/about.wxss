.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* 头部 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.logo image {
  width: 120rpx;
  height: 120rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.version {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 简介 */
.intro-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-align: justify;
}

/* 功能特点 */
.features-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(114, 46, 209, 0.1));
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.feature-icon image {
  width: 48rpx;
  height: 48rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

/* 技术栈 */
.tech-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.tech-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tech-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.tech-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  min-width: 160rpx;
}

.tech-desc {
  font-size: 26rpx;
  color: #666;
}

/* 联系方式 */
.contact-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.contact-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(114, 46, 209, 0.1));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.contact-icon image {
  width: 36rpx;
  height: 36rpx;
}

.contact-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 26rpx;
  color: #999;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  margin-top: 4rpx;
}

/* 底部 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.footer text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}
