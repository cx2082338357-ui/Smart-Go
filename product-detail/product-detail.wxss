.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

.loading-state text {
  font-size: 28rpx;
  color: #999;
}

/* 商品轮播图 */
.product-swiper {
  width: 100%;
  height: 750rpx;
  background: #fff;
}

.product-swiper image {
  width: 100%;
  height: 100%;
}

/* 价格区域 */
.price-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.price-info {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.current-price {
  color: #ff4d4f;
}

.price-symbol {
  font-size: 28rpx;
  font-weight: 600;
}

.price-value {
  font-size: 56rpx;
  font-weight: 700;
}

.original-price {
  font-size: 28rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.discount-tag {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.sales-info {
  display: flex;
  gap: 32rpx;
}

.sales, .stock {
  font-size: 24rpx;
  color: #999;
}

/* 商品信息 */
.product-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 店铺信息 */
.shop-section {
  background: #fff;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.shop-icon {
  width: 64rpx;
  height: 64rpx;
}

.shop-detail {
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.shop-location {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.tmall-badge {
  background: linear-gradient(135deg, #ff6a00, #ff9500);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 配送信息 */
.delivery-section {
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  gap: 40rpx;
  margin-bottom: 16rpx;
}

.delivery-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.delivery-icon {
  font-size: 28rpx;
}

.delivery-item text {
  font-size: 24rpx;
  color: #666;
}

/* 商品详情 */
.detail-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 相似推荐 */
.similar-section {
  background: #fff;
  padding: 24rpx;
}

.similar-scroll {
  display: flex;
  white-space: nowrap;
}

.similar-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
}

.similar-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.similar-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.similar-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
  display: block;
  margin-top: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-state text {
  font-size: 32rpx;
  color: #999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.quantity-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #f8f8f8;
}

.qty-btn:first-child {
  border-radius: 8rpx 0 0 8rpx;
}

.qty-btn:last-child {
  border-radius: 0 8rpx 8rpx 0;
}

.qty-value {
  width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.cart-btn {
  background: linear-gradient(135deg, #fa8c16, #ffc53d);
  color: #fff;
}

.buy-btn {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
