<view class="container">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <view class="profile-header">
      <image class="avatar" src="{{userInfo.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="profile-info" wx:if="{{isBindAccount}}">
        <text class="username">{{userInfo.name || '未绑定'}}</text>
        <text class="user-meta">{{userInfo.studentId || ''}} · {{userInfo.college || ''}}</text>
        <view class="user-tags">
          <text class="tag tag-primary">本科生</text>
          <text class="tag tag-success">已认证</text>
        </view>
      </view>
      <view class="profile-info" wx:else>
        <text class="username">未登录</text>
        <text class="user-meta">点击绑定教务账号</text>
        <view class="bind-btn" bindtap="goBindAccount">
          <text>立即绑定</text>
        </view>
      </view>
    </view>
    <view class="profile-stats" wx:if="{{isBindAccount}}">
      <view class="stat-item">
        <text class="stat-value">{{stats.credits || 0}}</text>
        <text class="stat-label">学分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.gpa || '0.00'}}</text>
        <text class="stat-label">GPA</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{stats.rank || '--'}}</text>
        <text class="stat-label">排名</text>
      </view>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="orders-card card" wx:if="{{isBindAccount}}">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <view class="card-more" bindtap="goToOrders">
        <text>全部订单</text>
        <image src="/assets/icons/right.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="orders-grid">
      <view class="order-item" wx:for="{{orderTabs}}" wx:key="type" bindtap="goToOrders" data-type="{{item.type}}">
        <view class="order-icon">
          <image src="{{item.icon}}" mode="aspectFit"></image>
          <view class="order-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
        </view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="goToPage" data-page="bind-account">
      <view class="menu-left">
        <image src="/assets/icons/account.png" mode="aspectFit"></image>
        <text>账号绑定</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="schedule-reminder">
      <view class="menu-left">
        <image src="/assets/icons/bell.png" mode="aspectFit"></image>
        <text>上课提醒</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="lost-found">
      <view class="menu-left">
        <image src="/assets/icons/lost.png" mode="aspectFit"></image>
        <text>寻物记录</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="delivery">
      <view class="menu-left">
        <image src="/assets/icons/delivery.png" mode="aspectFit"></image>
        <text>配送订单</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="delivery-apply" wx:if="{{isRider}}">
      <view class="menu-left">
        <image src="/assets/icons/rider.png" mode="aspectFit"></image>
        <text>成为骑手</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 其他服务 -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="goToPage" data-page="settings">
      <view class="menu-left">
        <image src="/assets/icons/settings.png" mode="aspectFit"></image>
        <text>设置</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="feedback">
      <view class="menu-left">
        <image src="/assets/icons/feedback.png" mode="aspectFit"></image>
        <text>意见反馈</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="about">
      <view class="menu-left">
        <image src="/assets/icons/about.png" mode="aspectFit"></image>
        <text>关于我们</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="callService">
      <view class="menu-left">
        <image src="/assets/icons/service.png" mode="aspectFit"></image>
        <text>联系客服</text>
      </view>
      <image class="menu-arrow" src="/assets/icons/right.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" wx:if="{{isBindAccount}}" bindtap="logout">
    <text>退出登录</text>
  </view>
</view>
