/* delivery-track.wxss */
.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.status-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1890ff, #4facfe);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.status-icon image {
  width: 56rpx;
  height: 56rpx;
}

.status-icon.done {
  background: rgba(255,255,255,0.3);
}

.status-info {
  flex: 1;
}

.status-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.status-eta {
  font-size: 26rpx;
  opacity: 0.85;
}

.rider-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.rider-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.rider-avatar image {
  width: 100%;
  height: 100%;
}

.rider-info {
  flex: 1;
}

.rider-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.rider-desc {
  font-size: 24rpx;
  color: #999;
}

.call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #1890ff;
  border-radius: 16rpx;
}

.call-btn image {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
}

.call-btn text {
  font-size: 22rpx;
  color: #fff;
}

.route-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.route-item {
  display: flex;
  align-items: flex-start;
}

.route-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #1890ff;
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.route-item.delivery .route-dot {
  background: #52c41a;
}

.route-content {
  flex: 1;
}

.route-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.route-value {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.route-line {
  width: 4rpx;
  height: 48rpx;
  background: linear-gradient(to bottom, #1890ff, #52c41a);
  margin-left: 10rpx;
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.progress-card,
.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 28rpx;
}

.progress-steps {
  display: flex;
  flex-direction: column;
}

.step-item {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.step-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: #eee;
}

.step-item.done:not(:last-child)::after {
  background: #52c41a;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot image {
  width: 24rpx;
  height: 24rpx;
}

.step-item .step-dot::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ddd;
}

.step-item.done .step-dot::before {
  background: #52c41a;
  width: 12rpx;
  height: 12rpx;
}

.step-item.current .step-dot::before {
  background: #1890ff;
  width: 16rpx;
  height: 16rpx;
}

.step-pulse {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(24, 144, 255, 0.2);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 1; }
  100% { transform: scale(1.6); opacity: 0; }
}

.step-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.step-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.step-item.done .step-text,
.step-item.current .step-text {
  color: #333;
}

.step-item.current .step-text {
  color: #1890ff;
  font-weight: 600;
}

.step-time {
  font-size: 22rpx;
  color: #bbb;
  display: block;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-row:last-child {
  border-bottom: none;
}

.order-label {
  font-size: 28rpx;
  color: #999;
}

.order-value {
  font-size: 28rpx;
  color: #333;
}
