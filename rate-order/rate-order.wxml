<view class="container">
  <!-- 订单信息 -->
  <view class="order-info card" wx:if="{{orderInfo}}">
    <view class="shop-info">
      <image class="shop-icon" src="/assets/icons/shop.png" mode="aspectFit"></image>
      <text class="shop-name">{{orderInfo.shopName}}</text>
    </view>
    <view class="order-products">
      <text wx:for="{{orderInfo.products}}" wx:key="index" class="product-text">
        {{item.name}} x{{item.count}}{{index < orderInfo.products.length - 1 ? '、' : ''}}
      </text>
    </view>
  </view>

  <!-- 配送评分 -->
  <view class="rating-section card">
    <view class="section-title">配送服务</view>
    <view class="rating-row">
      <text class="rating-label">配送评分</text>
      <view class="rating-stars">
        <view 
          class="star {{deliveryRating >= index + 1 ? 'active' : ''}}" 
          wx:for="{{5}}" 
          wx:key="index"
          data-rating="{{index + 1}}"
          bindtap="setDeliveryRating"
        >
          <image src="{{deliveryRating >= index + 1 ? '/assets/icons/star-active.png' : '/assets/icons/star.png'}}" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 服务评分 -->
  <view class="rating-section card">
    <view class="section-title">骑手服务</view>
    <view class="rating-row">
      <text class="rating-label">服务态度</text>
      <view class="rating-stars">
        <view 
          class="star {{serviceRating >= index + 1 ? 'active' : ''}}" 
          wx:for="{{5}}" 
          wx:key="index"
          data-rating="{{index + 1}}"
          bindtap="setServiceRating"
        >
          <image src="{{serviceRating >= index + 1 ? '/assets/icons/star-active.png' : '/assets/icons/star.png'}}" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 综合评分 -->
  <view class="rating-section card">
    <view class="section-title">综合评分</view>
    <view class="main-rating">
      <view class="big-star" data-rating="{{rating}}" bindtap="setRating">
        <block wx:for="{{5}}" wx:key="index">
          <image 
            class="star-img {{rating >= index + 1 ? 'active' : ''}}"
            src="{{rating >= index + 1 ? '/assets/icons/star-active.png' : '/assets/icons/star.png'}}" 
            mode="aspectFit"
          ></image>
        </block>
      </view>
      <text class="rating-desc">{{rating === 5 ? '非常满意' : rating === 4 ? '满意' : rating === 3 ? '一般' : rating === 2 ? '不满意' : '非常不满意'}}</text>
    </view>
  </view>

  <!-- 评价标签 -->
  <view class="tags-section card">
    <view class="section-title">选择标签（可选，最多5个）</view>
    <view class="tags-grid">
      <view 
        class="tag-item {{selectedTags.indexOf(item) > -1 ? 'selected' : ''}}" 
        wx:for="{{tagOptions}}" 
        wx:key="index"
        data-tag="{{item}}"
        bindtap="toggleTag"
      >
        <image wx:if="{{selectedTags.indexOf(item) > -1}}" src="/assets/icons/like-active.png" mode="aspectFit"></image>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="content-section card">
    <view class="section-title">评价内容</view>
    <textarea 
      class="content-input"
      placeholder="分享您的购物体验，帮助其他同学做出更好的选择..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
    ></textarea>
    <view class="content-count">{{content.length || 0}}/500</view>

    <!-- 快速评价模板 -->
    <view class="quick-templates">
      <text class="template-label">快捷评价：</text>
      <view class="template-list">
        <view 
          class="template-item" 
          data-template="配送很快，骑手态度很好，商品完好无损，下次还会购买！"
          bindtap="useQuickTemplate"
        >
          好评模板1
        </view>
        <view 
          class="template-item"
          data-template="商品质量不错，配送及时，整体满意，推荐购买！"
          bindtap="useQuickTemplate"
        >
          好评模板2
        </view>
      </view>
    </view>
  </view>

  <!-- 图片上传 -->
  <view class="images-section card">
    <view class="section-title">上传图片（可选，最多9张）</view>
    <view class="images-grid">
      <view class="image-item" wx:for="{{images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-index="{{index}}"></image>
        <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">
          <image src="/assets/icons/close.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="add-image" bindtap="chooseImage" wx:if="{{images.length < 9}}">
        <image src="/assets/icons/add.png" mode="aspectFit"></image>
        <text>添加图片</text>
      </view>
    </view>
  </view>

  <!-- 匿名评价 -->
  <view class="anonymous-section card">
    <view class="anonymous-toggle">
      <text>匿名评价</text>
      <switch checked="{{anonymous}}" bindchange="toggleAnonymous" color="#1890ff"></switch>
    </view>
    <text class="anonymous-hint">开启后，评价将不会显示您的昵称和头像</text>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitReview" loading="{{submitLoading}}">
      提交评价
    </button>
  </view>
</view>
