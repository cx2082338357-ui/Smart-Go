.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.shop-icon {
  width: 48rpx;
  height: 48rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.order-products {
  padding-left: 64rpx;
}

.product-text {
  font-size: 26rpx;
  color: #666;
}

.rating-section {
  padding: 28rpx;
}

.rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-label {
  font-size: 28rpx;
  color: #333;
}

.rating-stars {
  display: flex;
  gap: 12rpx;
}

.star image {
  width: 48rpx;
  height: 48rpx;
}

.main-rating {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.big-star {
  display: flex;
  gap: 8rpx;
}

.star-img {
  width: 64rpx;
  height: 64rpx;
}

.rating-desc {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

.tags-section {
  padding: 28rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.tag-item.selected {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
  border-color: #1890ff;
}

.tag-item image {
  width: 28rpx;
  height: 28rpx;
}

.content-section {
  padding: 28rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.content-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.quick-templates {
  margin-top: 24rpx;
}

.template-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.template-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.template-item {
  padding: 12rpx 24rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1890ff;
}

.images-section {
  padding: 28rpx;
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-btn image {
  width: 24rpx;
  height: 24rpx;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-image image {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.5;
}

.add-image text {
  font-size: 24rpx;
  color: #999;
}

.anonymous-section {
  padding: 28rpx;
}

.anonymous-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anonymous-toggle text {
  font-size: 28rpx;
  color: #333;
}

.anonymous-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}
