.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 周次选择器 */
.week-selector {
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  padding: 24rpx 32rpx;
  color: #fff;
}

.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn image {
  width: 32rpx;
  height: 32rpx;
}

.week-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.week-label {
  font-size: 36rpx;
  font-weight: 600;
}

.week-date {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 周日期选择 */
.day-selector {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.day-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.day-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin: 0 8rpx;
  position: relative;
  transition: all 0.3s;
}

.day-item.active {
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(114, 46, 209, 0.1));
}

.day-name {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.day-item.active .day-name {
  color: #1890ff;
  font-weight: 600;
}

.day-date {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.day-item.active .day-date {
  color: #1890ff;
}

.has-class {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

/* 课程列表 */
.course-list {
  padding: 24rpx;
}

.course-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.course-time-bar {
  width: 8rpx;
}

.course-content {
  flex: 1;
  padding: 24rpx;
}

.course-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.course-type {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.course-details {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.detail-item image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.course-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.action-btn image {
  width: 28rpx;
  height: 28rpx;
}

.action-btn.active {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-state-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
  pointer-events: none;
}

.loading-state text {
  font-size: 28rpx;
  color: #999;
}

/* 侧边快捷操作 */
.quick-actions-fab {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fab-item {
  width: 96rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.fab-item image {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.fab-item text {
  font-size: 18rpx;
  color: #666;
}
