<view class="container">
  <!-- 类型切换 -->
  <view class="type-tabs">
    <view 
      class="tab-item {{currentType === 'lost' ? 'active' : ''}}"
      bindtap="switchType"
      data-type="lost"
    >
      <image src="/assets/icons/lost.png" mode="aspectFit"></image>
      <text>寻物</text>
      <view class="tab-count">{{lostCount}}</view>
    </view>
    <view 
      class="tab-item {{currentType === 'found' ? 'active' : ''}}"
      bindtap="switchType"
      data-type="found"
    >
      <image src="/assets/icons/found.png" mode="aspectFit"></image>
      <text>招领</text>
      <view class="tab-count">{{foundCount}}</view>
    </view>
  </view>

  <!-- AI 智能匹配提示 -->
  <view class="ai-match-tip" wx:if="{{hasMatch}}">
    <view class="tip-icon">
      <image src="/assets/icons/ai-badge.png" mode="aspectFit"></image>
    </view>
    <view class="tip-content">
      <text class="tip-title">AI 智能匹配</text>
      <text class="tip-desc">有 {{matchCount}} 条相关信息可能与您相关</text>
    </view>
    <view class="tip-btn" bindtap="viewMatches">
      <text>查看</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view 
      class="item-card {{item.type}}"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <!-- 卡片头部 -->
      <view class="card-header">
        <view class="type-badge">
          <text>{{item.type === 'lost' ? '寻物' : '招领'}}</text>
        </view>
        <view class="time">{{item.timeAgo}}</view>
      </view>

      <!-- 物品信息 -->
      <view class="card-content">
        <view class="item-images" wx:if="{{item.images && item.images.length > 0}}">
          <image 
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="index"
            src="{{img}}"
            mode="aspectFill"
            bindtap="previewImage"
            data-url="{{img}}"
          ></image>
        </view>
        <view class="item-info">
          <text class="item-title">{{item.title}}</text>
          <text class="item-desc">{{item.description}}</text>
          <view class="item-meta">
            <view class="meta-item">
              <image src="/assets/icons/location.png" mode="aspectFit"></image>
              <text>{{item.location}}</text>
            </view>
            <view class="meta-item">
              <image src="/assets/icons/time.png" mode="aspectFit"></image>
              <text>{{item.lostTime}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 卡片底部 -->
      <view class="card-footer">
        <view class="user-info">
          <image class="avatar" src="{{item.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
          <text class="nickname">{{item.nickname}}</text>
        </view>
        <view class="stats">
          <view class="stat-item">
            <image src="/assets/icons/eye.png" mode="aspectFit"></image>
            <text>{{item.views || 0}}</text>
          </view>
          <view class="stat-item">
            <image src="/assets/icons/comment.png" mode="aspectFit"></image>
            <text>{{item.comments || 0}}</text>
          </view>
        </view>
      </view>

      <!-- AI 匹配标签 -->
      <view class="ai-match" wx:if="{{item.isMatch}}">
        <image src="/assets/icons/ai-badge.png" mode="aspectFit"></image>
        <text>AI 匹配</text>
      </view>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="publish-btn" bindtap="publish">
    <image src="/assets/icons/add.png" mode="aspectFit"></image>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{items.length === 0 && !loading}}">
    <image class="empty-icon" src="/assets/icons/empty-lost.png" mode="aspectFit"></image>
    <text class="empty-text">{{currentType === 'lost' ? '暂无寻物启事' : '暂无失物招领'}}</text>
    <text class="empty-hint">点击下方按钮发布信息</text>
  </view>
</view>
