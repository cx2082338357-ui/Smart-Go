.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  background: #fff;
  padding: 24rpx 32rpx;
  gap: 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  transition: all 0.3s;
  position: relative;
}

.tab-item.active {
  background: linear-gradient(135deg, rgba(245, 34, 45, 0.1), rgba(255, 120, 117, 0.1));
}

.tab-item image {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
}

.tab-item text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active text {
  color: #f5222d;
  font-weight: 600;
}

.tab-count {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #f5222d;
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* AI 匹配提示 */
.ai-match-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(24, 144, 255, 0.1), rgba(114, 46, 209, 0.1));
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
}

.tip-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
}

.tip-icon image {
  width: 100%;
  height: 100%;
}

.tip-content {
  flex: 1;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890ff;
  display: block;
  margin-bottom: 4rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #666;
}

.tip-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #1890ff, #69c0ff);
  border-radius: 24rpx;
}

.tip-btn text {
  font-size: 26rpx;
  color: #fff;
}

/* 列表 */
.list {
  padding: 24rpx;
}

.item-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  position: relative;
}

.item-card.lost {
  border-left: 6rpx solid #f5222d;
}

.item-card.found {
  border-left: 6rpx solid #52c41a;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.type-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.item-card.lost .type-badge {
  background: rgba(245, 34, 45, 0.1);
  color: #f5222d;
}

.item-card.found .type-badge {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.type-badge text {
  font-size: 24rpx;
  font-weight: 600;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 卡片内容 */
.card-content {
  padding: 20rpx 24rpx;
}

.item-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.item-images image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.item-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-item image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.meta-item text {
  font-size: 24rpx;
  color: #999;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.nickname {
  font-size: 26rpx;
  color: #666;
}

.stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-item image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

.stat-item text {
  font-size: 24rpx;
  color: #999;
}

/* AI 匹配标签 */
.ai-match {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #1890ff, #722ed1);
  border-radius: 16rpx;
}

.ai-match image {
  width: 24rpx;
  height: 24rpx;
}

.ai-match text {
  font-size: 22rpx;
  color: #fff;
}

/* 发布按钮 */
.publish-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #f5222d, #ff7875);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(245, 34, 45, 0.4);
  z-index: 100;
}

.publish-btn image {
  width: 48rpx;
  height: 48rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}
