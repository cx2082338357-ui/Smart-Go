.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx;
  color: #999;
}

.status-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  color: #fff;
  font-size: 32rpx;
}

.status-header.pending,
.status-header.status-pending { background: #ff9800; }
.status-header.delivering,
.status-header.status-delivering { background: #2196f3; }
.status-header.delivered,
.status-header.status-delivered { background: #9c27b0; }
.status-header.completed,
.status-header.status-completed { background: #4caf50; }
.status-header.cancelled,
.status-header.status-cancelled { background: #999; }

.status-icon { font-size: 48rpx; margin-right: 16rpx; }

.section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.product-list {}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:last-child { border-bottom: none; }

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.product-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.product-price {
  font-size: 28rpx;
  color: #333;
}

.product-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.info-list {}

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  flex: 1;
}

.copy-btn {
  font-size: 24rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border: 1rpx solid #1890ff;
  border-radius: 4rpx;
  margin-left: 16rpx;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #ff5000;
  font-weight: bold;
}

.action-bar {
  display: flex;
  justify-content: flex-end;
  padding: 30rpx;
  background: #fff;
  gap: 20rpx;
}

.action-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: #ff5000;
  color: #fff;
}

.btn-outline {
  border: 1rpx solid #ddd;
  color: #666;
}
