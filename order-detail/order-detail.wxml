<view class="container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 订单不存在 -->
  <view class="empty-state" wx:if="{{!loading && !order}}">
    <text>订单不存在</text>
  </view>

  <!-- 订单详情 -->
  <block wx:if="{{!loading && order}}">
    <!-- 状态头部 -->
    <view class="status-header status-{{order.statusClass}}">
      <text class="status-icon">{{order.status === 'pending' ? '⏰' : order.status === 'delivering' ? '🚴' : order.status === 'delivered' ? '📦' : order.status === 'completed' ? '✅' : '❌'}}</text>
      <text class="status-text">{{order.statusText}}</text>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-title">商品信息</view>
      <view class="product-list">
        <view class="product-item" wx:for="{{order.products}}" wx:key="id">
          <image class="product-image" src="{{item.image || '/assets/icons/goods.png'}}" mode="aspectFill" lazy-load></image>
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <text class="product-spec">{{item.spec || '默认规格'}}</text>
          </view>
          <view class="product-right">
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-count">x{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="section-title">订单信息</view>
      <view class="info-list">
        <view class="info-row">
          <text class="info-label">订单编号</text>
          <text class="info-value">{{order.orderNo}}</text>
          <view class="copy-btn" bindtap="copyOrderNo">复制</view>
        </view>
        <view class="info-row">
          <text class="info-label">下单时间</text>
          <text class="info-value">{{order.createTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">店铺</text>
          <text class="info-value">{{order.shopName}}</text>
        </view>
      </view>
    </view>

    <!-- 金额 -->
    <view class="section">
      <view class="total-row">
        <text class="total-label">合计</text>
        <text class="total-price">¥{{order.totalPrice}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view class="action-btn btn-outline" wx:if="{{order.status === 'pending'}}" bindtap="payOrder">立即支付</view>
      <view class="action-btn btn-primary" wx:if="{{order.status === 'delivered'}}" bindtap="confirmReceive">确认收货</view>
      <view class="action-btn btn-outline" wx:if="{{order.status === 'completed'}}" bindtap="reOrder">再来一单</view>
    </view>
  </block>
</view>
