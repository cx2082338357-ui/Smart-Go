.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 状态标签 */
.status-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  position: relative;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #fa8c16;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #fa8c16;
  border-radius: 2rpx;
}

.tab-item text {
  font-size: 28rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

/* 订单列表 */
.order-list {
  padding: 24rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.shop-info {
  display: flex;
  align-items: center;
}

.shop-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.order-status {
  font-size: 26rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
}

.order-status.pending { color: #fa8c16; background: rgba(250, 140, 22, 0.12); }
.order-status.delivering { color: #1890ff; background: rgba(24, 144, 255, 0.16); }
.order-status.delivered { color: #52c41a; background: rgba(82, 196, 26, 0.12); }
.order-status.completed { color: #999; background: rgba(0, 0, 0, 0.06); }
.order-status.cancelled { color: #999; background: rgba(0, 0, 0, 0.06); }

/* 商品列表 */
.order-products {
  padding: 20rpx 24rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
}

.product-price {
  text-align: right;
}

.price {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.count {
  font-size: 24rpx;
  color: #999;
}

.more-products {
  text-align: center;
  padding-top: 12rpx;
  color: #1890ff;
  font-size: 26rpx;
}

/* 订单信息 */
.order-info {
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #999;
}

.value {
  color: #666;
}

.copy-btn {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #666;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f5f5f5;
}

.total-price .label {
  font-size: 26rpx;
  color: #666;
}

.total-price .price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4d4f;
  display: inline;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.action-btn.btn-primary {
  background: linear-gradient(135deg, #fa8c16, #ffc53d);
  color: #fff;
}

.action-btn.btn-outline {
  border: 1rpx solid #ddd;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #fa8c16, #ffc53d);
  border-radius: 40rpx;
}

.empty-btn text {
  color: #fff;
  font-size: 30rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
}

.load-more text {
  font-size: 28rpx;
  color: #fa8c16;
}

/* 扫码支付弹窗（与 delivery 页面共用） */
.pay-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.modal-content {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-header text {
  font-size: 32rpx;
  font-weight: 600;
}
.close-btn { width: 40rpx; height: 40rpx; }
.close-btn image { width: 100%; height: 100%; }
.modal-body { padding: 32rpx; }
.qrcode-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.qrcode-img { width: 400rpx; height: 400rpx; border-radius: 12rpx; }
.qrcode-hint { font-size: 22rpx; color: #999; margin-top: 16rpx; text-align: center; }
.paid-tip { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-bottom: 24rpx; font-size: 26rpx; color: #52c41a; }
.paid-icon { font-size: 32rpx; }
.pay-amount { text-align: center; margin-bottom: 32rpx; }
.pay-amount .amount { font-size: 64rpx; font-weight: 700; color: #ff4d4f; display: block; }
.pay-amount .amount-tip { font-size: 24rpx; color: #999; display: block; margin-top: 8rpx; }
.pay-amount .label { font-size: 28rpx; color: #666; display: block; margin-bottom: 12rpx; }
.pay-btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #fa8c16, #ffc53d);
  border-radius: 48rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.pay-btn::after { border: none; }
