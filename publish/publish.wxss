.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.publish-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.content-section {
  margin-bottom: 24rpx;
}

.content-input {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  padding: 0;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.image-section {
  margin-bottom: 24rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.add-image {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-image image {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.add-image text {
  font-size: 24rpx;
  color: #999;
}

.tag-section {
  margin-bottom: 32rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.tag-item.active {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
  border-color: #1890ff;
}

.publish-btn {
  background: linear-gradient(135deg, #722ed1, #b37feb);
  color: #fff;
  border-radius: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.publish-btn.loading {
  opacity: 0.7;
}
