.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 分类标签 */
.category-tabs {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 12rpx 20rpx;
  margin: 0 8rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #722ed1;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
}

.tab-item text {
  font-size: 24rpx;
  white-space: nowrap;
}

/* 发布入口 */
.publish-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.publish-hint {
  display: flex;
  align-items: center;
  flex: 1;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 36rpx;
}

.publish-hint image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.publish-hint text {
  font-size: 28rpx;
  color: #999;
}

.publish-btn {
  margin-left: 20rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #722ed1, #b37feb);
  border-radius: 32rpx;
}

.publish-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 帖子列表 */
.post-list {
  padding: 0 24rpx;
}

.post-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.more-btn {
  width: 40rpx;
  height: 40rpx;
}

.more-btn image {
  width: 100%;
  height: 100%;
}

/* 帖子内容 */
.post-content {
  margin-bottom: 16rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}

.image-item {
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

/* 标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 24rpx;
  color: #722ed1;
  background: rgba(114, 46, 209, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* 互动栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #999;
}

.action-item.active {
  color: #722ed1;
}

.action-item image {
  width: 36rpx;
  height: 36rpx;
}

.action-item text {
  font-size: 26rpx;
}

/* AI 标签 */
.ai-tags {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.ai-tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #1890ff;
}

.ai-tag-item image {
  width: 24rpx;
  height: 24rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
}

.load-more text {
  font-size: 28rpx;
  color: #722ed1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 底部导航 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #f0f0f0;
  z-index: 100;
}

.tab-bar .tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.tab-bar .tab-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-bar .tab-item text {
  font-size: 22rpx;
  color: #999;
}

.tab-bar .tab-item.active text {
  color: #722ed1;
}

.tab-bar .publish {
  margin-top: -30rpx;
}

.tab-bar .publish image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #722ed1, #b37feb);
  box-shadow: 0 4rpx 16rpx rgba(114, 46, 209, 0.3);
}
